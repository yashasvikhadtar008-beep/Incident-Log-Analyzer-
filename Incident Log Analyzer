def analyze_log(filename):
    log_count = {
        "INFO": 0,
        "WARNING": 0,
        "ERROR": 0
    }

    error_messages = []

    total_entries = 0

    try:
        with open(filename, "r") as file:

            for line in file:

                line = line.strip()

                if line == "":
                    continue

                parts = line.split(" ", 3)

                if len(parts) < 4:
                    print("Skipped malformed line:", line)
                    continue

                date = parts[0]
                time = parts[1]
                level = parts[2]
                message = parts[3]

                if level not in log_count:
                    print("Skipped invalid log level:", level)
                    continue

                total_entries += 1
                log_count[level] += 1

                if level == "ERROR":
                    error_messages.append(message)

    except FileNotFoundError:
        print("Error: Log file not found.")
        return

    print("\n----- Log Analysis -----")
    print("Total entries:", total_entries)
    print("INFO:", log_count["INFO"])
    print("WARNING:", log_count["WARNING"])
    print("ERROR:", log_count["ERROR"])

    print("\n----- ERROR MESSAGES -----")

    if len(error_messages) == 0:
        print("No ERROR messages found.")
    else:
        for message in error_messages:
            print("-", message)
            
analyze_log("app.log")